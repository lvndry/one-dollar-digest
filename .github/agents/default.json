{
  "id": "default",
  "name": "default",
  "description": "One Dollar Digest research agent",
  "config": {
    "persona": "default",
    "llm": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4.1-flash",
      "temperature": 0.1,
      "maxOutputTokens": 16000
    },
    "envAllowlist": ["TYPESAFE_API_KEY"],
    "tools": [
      "web_search",
      "http_request",
      "read_file",
      "write_file",
      "edit_file",
      "ls",
      "find",
      "grep",
      "mkdir",
      "execute_command",
      "spawn_subagent",
      "todo",
      "web_fetch"
    ]
  }
}
